# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Local project instructions and assistant state, never part of the public source.
/AGENTS.md
/CLAUDE.md
/HANDOFF.private.md
/.codex/
/.claude/

# Rust
/target/
**/target/

# Node
node_modules/
.pnpm-store/
dist/
dist-ssr/
*.tsbuildinfo
coverage/

# Tauri generated schemas (regenerated on build)
apps/desktop/src-tauri/gen/schemas/

# Cloudflare / Wrangler
.wrangler/
.dev.vars*

# Env and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
*.cer
*.mobileprovision

# Logs and test output
*.log
npm-debug.log*
pnpm-debug.log*
playwright-report/
test-results/

# Local git worktrees for parallel milestone tracks
.worktrees/

# Local browser automation output
/.playwright-mcp/

# Dictation models, fetched and verified by apps/desktop/scripts/dictation-models.mjs.
apps/desktop/src-tauri/resources/dictation/*.gguf
apps/desktop/src-tauri/resources/dictation/*.partial
apps/desktop/src-tauri/resources/speech/*.gguf
apps/desktop/src-tauri/resources/speech/*.safetensors
apps/desktop/src-tauri/resources/speech/config.json
apps/desktop/src-tauri/resources/speech/tokenizer.json
apps/desktop/src-tauri/resources/speech/voices/
apps/desktop/src-tauri/resources/speech/**/*.partial
