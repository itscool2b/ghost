{
  "name": "ghost",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ghost/desktop tauri dev",
    "bundle": "pnpm --filter @ghost/desktop bundle",
    "signing": "pnpm --filter @ghost/desktop signing",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test .github/scripts/check-changelog.test.mjs .github/scripts/check-version.test.mjs .github/scripts/check-instructions.test.mjs .github/scripts/check-styles.test.mjs .github/scripts/third-party-notices.test.mjs && pnpm -r --if-present test",
    "lint": "node .github/scripts/check-changelog.mjs && node .github/scripts/check-version.mjs && node .github/scripts/check-instructions.mjs && node .github/scripts/check-styles.mjs && biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "typescript": "7.0.2"
  }
}
