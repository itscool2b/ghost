# Biome, shell scripts and protocol fixtures use LF on every platform. Binary files stay binary.
* text=auto eol=lf
# Keep mirrored instructions byte-identical across Windows and Unix checkouts.
/AGENTS.md text eol=lf
/CLAUDE.md text eol=lf
# The pinned scrcpy server is a jar: never touch its bytes.
/crates/ghost-devices/resources/scrcpy-server-* binary
# The iPhone app's fonts and images are binary.
/apps/ios/**/*.ttf binary
/apps/ios/**/*.png binary
