{
  "name": "@ghost/relay",
  "private": true,
  "type": "module",
  "scripts": {
    "worker:build": "wrangler deploy --dry-run --env= --outdir build",
    "worker:test": "wrangler deploy --dry-run --env= --outdir build && node --test tests/runtime.test.mjs",
    "worker:e2e": "wrangler deploy --dry-run --env= --outdir build && node tests/e2e.mjs",
    "worker:check": "wrangler deploy --dry-run --env production --outdir ../../target/relay-dry-run",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "miniflare": "5.20261019.2-beta",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
