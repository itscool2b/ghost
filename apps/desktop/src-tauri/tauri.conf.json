{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost",
  "mainBinaryName": "ghost",
  "identifier": "dev.onghost.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm --filter @ghost/desktop dev",
    "beforeBuildCommand": "pnpm --filter @ghost/desktop build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Ghost ADE",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "preventOverflow": true,
        "visible": false,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/dictation/": "dictation/",
      "resources/speech/": "speech/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "libssl3t64 | libssl3",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-gl",
          "gstreamer1.0-pulseaudio | gstreamer1.0-alsa"
        ],
        "section": "devel",
        "conflicts": ["o7", "auracode"],
        "replaces": ["o7", "auracode"]
      },
      "rpm": {
        "depends": [
          "libasound.so.2()(64bit)",
          "libayatana-appindicator3.so.1()(64bit)",
          "libssl.so.3()(64bit)",
          "libcrypto.so.3()(64bit)",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good"
        ],
        "conflicts": ["o7", "auracode"],
        "obsoletes": ["o7", "auracode"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "One home for all your coding agents.",
    "longDescription": "Ghost runs your coding agents through their own harnesses, with local chats and reviewed Git workspaces in one desktop app. Everything stays on your computer.",
    "homepage": "https://onghost.dev",
    "copyright": "Copyright 2026 BASH.AI LLC",
    "macOS": {
      "minimumSystemVersion": "13.3",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["English"],
        "customLanguageFiles": {
          "English": "./windows/English.nsh"
        }
      }
    },
    "publisher": "Ghost"
  }
}
