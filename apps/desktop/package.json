{
  "name": "@ghost/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Ghost desktop app: React UI for the Tauri shell in src-tauri.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test scripts/build-env.test.mjs scripts/host-upgrade.test.mjs scripts/appimage-upgrade.test.mjs scripts/appimage-media.test.mjs scripts/uninstaller-hooks.test.mjs scripts/game-starters.test.mjs && vitest run",
    "check:chat": "node scripts/check-chat.mjs",
    "check:customization": "node scripts/check-customization-suite.mjs",
    "check:fixtures": "node scripts/check-fixture-suite.mjs",
    "check:header-labels": "node scripts/check-header-labels.mjs",
    "check:layout": "node scripts/check-layout.mjs --sizes 1440x900,960x640 --focus-steps 120",
    "check:setup": "node scripts/check-setup.mjs",
    "check:settings": "node scripts/check-settings.mjs",
    "tauri": "tauri",
    "bundle": "node scripts/bundle.mjs",
    "host-upgrade": "node scripts/host-upgrade.mjs",
    "signing": "sh scripts/macos-signing.sh",
    "icons": "node scripts/app-icons.mjs"
  },
  "dependencies": {
    "@ghost/ui": "workspace:*",
    "@tanstack/react-virtual": "3.14.22",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "lucide-react": "1.55.0",
    "mermaid": "12.3.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.181.2",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.181.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.63.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
