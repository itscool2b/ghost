{
  "name": "@o7/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "o7 design system shared by the desktop app and o7.codes: Graphite (tokens, primitives, AgentMark, Logo), plus the legacy Aura and Orbit modules.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./desktop-fonts.css": "./src/desktop-fonts.css",
    "./graphite": "./src/graphite/index.ts",
    "./bot-mark": "./src/graphite/BotMark.tsx",
    "./graphite.css": "./src/graphite/graphite.css",
    "./graphite-tokens.css": "./src/graphite/tokens.css",
    "./themes.css": "./src/graphite/themes.css",
    "./orbit": "./src/orbit/index.ts",
    "./orbit.css": "./src/orbit/orbit.css",
    "./orbit-tokens.css": "./src/orbit/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "ogl": "1.0.11"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "5.0.5"
  }
}
